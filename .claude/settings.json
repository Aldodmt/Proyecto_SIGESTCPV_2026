{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(/c/xampp/php/php.exe -l *)",
      "Bash(/c/xampp/php/php.exe -v)",
      "Bash(C:/xampp/php/php.exe -l *)",
      "PowerShell(C:\\xampp\\php\\php.exe -l *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(tasklist *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(mysql *)",
      "Bash(mysqldump *)",
      "Bash(mysqladmin *)",
      "Bash(*mysqld.exe*)",
      "PowerShell(*mysql*)"
    ],
    "deny": [
      "Read(config/mail.php)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(C:/xampp/mysql/data/**)",
      "Edit(C:/xampp/mysql/**)",
      "Edit(database/backups/*.sql)",
      "Bash(cat config/mail.php)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(taskkill *)",
      "Bash(*DROP DATABASE*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(taskkill *)",
      "PowerShell(Stop-Process *)"
    ]
  }
}
